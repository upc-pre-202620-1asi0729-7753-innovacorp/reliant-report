  * pattern : VARCHAR(120) 
  subsystem_type : VARCHAR(30) 
  part_type : VARCHAR(30) 
  parameter : VARCHAR(50) 
  * tag_kind : VARCHAR(20) 
  * status_role : VARCHAR(20) 
  * priority : INTEGER 
  * created_at : TIMESTAMPTZ 
  * updated_at : TIMESTAMPTZ 
}
hvof_subsystems }o--|| hvof_systems : hvof_system_id
hvof_subsystem_parameters }o--|| hvof_subsystems : hvof_subsystem_id
hvof_parts }o--|| hvof_subsystems : hvof_subsystem_id
controllers }o--|| hvof_systems : hvof_system_id
controllers }o--o| controller_tag_catalogs : tag_catalog_id
controller_supported_protocols }o--|| controllers : controller_id
tag_nodes }o--|| controller_tag_catalogs : tag_catalog_id
tag_nodes }o--o| tag_nodes : parent_id
tag_mappings }o--|| hvof_systems : hvof_system_id
tag_mappings }o--|| controllers : controller_id
tag_mappings }o--o| hvof_subsystems : subsystem_id
tag_mappings }o--o| hvof_parts : part_id
tag_mappings }o--o| tag_mapping_rules : matched_rule_id
derived_parameter_definitions }o--|| hvof_systems : hvof_system_id
derived_parameter_input_tags }o--|| derived_parameter_definitions : derived_parameter_id
