  * unit_symbol : VARCHAR(15) 
  * unit_category : VARCHAR(20) 
  * unit_system : VARCHAR(25) 
}
users }o--|| organizations : organization_id
user_roles }o--|| users : user_id
user_roles }o--|| roles : role_id
user_preferences |o--|| users : user_id
user_preference_unit_overrides }o--|| user_preferences : user_preference_id
}

package "Billing" #FFF8E1 {
