@startuml Reliant_Reporting_Database
skinparam linetype ortho
skinparam packageStyle rectangle
hide circle
hide empty members

package "Reporting" #F1F8E9 {
entity "reporting_events" as reporting_events {
  * id : BIGINT <<PK>>
  --
  * event_type : VARCHAR(80) 
  * source_context : VARCHAR(40) 
  * aggregate_id : BIGINT 
  * organization_id : BIGINT 
  * occurred_at : TIMESTAMPTZ 
  * payload : JSONB 
  * created_at : TIMESTAMPTZ 
  * updated_at : TIMESTAMPTZ 
}
entity "quality_certificates" as quality_certificates {
  * id : BIGINT <<PK>>
  --
  * recuperation_id : BIGINT <<UK>>
  * component_id : BIGINT 
  * customer_id : BIGINT 
  * supplier_organization_id : BIGINT 
  issued_by_user_id : BIGINT 
  issued_at : TIMESTAMPTZ 
  justification : VARCHAR(500) 
  * status : VARCHAR(20) 
  * created_at : TIMESTAMPTZ 
  * updated_at : TIMESTAMPTZ 
}
entity "quality_certificate_sessions" as quality_certificate_sessions {
  * quality_certificate_id : BIGINT <<PK>> <<FK>>
  * session_id : BIGINT <<PK>>
  --
}
entity "quality_certificate_parameter_compliance" as quality_certificate_parameter_compliance {
  * quality_certificate_id : BIGINT <<PK>> <<FK>>
  * parameter : VARCHAR(50) <<PK>>
  --
  * min_observed : NUMERIC(18,6) 
  * max_observed : NUMERIC(18,6) 
  * within_nominal : BOOLEAN 
}
entity "pcr_compliance_reports" as pcr_compliance_reports {
  * id : BIGINT <<PK>>
  --
  * organization_id : BIGINT 
  * period_from : DATE 
  * period_to : DATE 
  * period_grouping : VARCHAR(10) 
  * grouped_by : VARCHAR(20) 
  * created_at : TIMESTAMPTZ 
  * updated_at : TIMESTAMPTZ 
}
entity "pcr_compliance_entries" as pcr_compliance_entries {
  * pcr_compliance_report_id : BIGINT <<PK>> <<FK>>
  * group_key : VARCHAR(80) <<PK>>
  --
  * total_components : INTEGER 
  * met_pcr_count : INTEGER 
  * premature_failure_count : INTEGER 
}
entity "report_templates" as report_templates {
  * id : BIGINT <<PK>>
  --
  * organization_id : BIGINT 
  * owner_user_id : BIGINT 
  * name : VARCHAR(80) 
  description : VARCHAR(255) 
  * report_kind : VARCHAR(25) 
  logo_asset_key : VARCHAR(200) 
  primary_color : VARCHAR(7) 
  secondary_color : VARCHAR(7) 
  header_text : VARCHAR(120) 
  footer_text : VARCHAR(120) 
  * page_size : VARCHAR(10) 
  * orientation : VARCHAR(10) 
  * columns : INTEGER 
  * show_signature_block : BOOLEAN 
  * visibility : VARCHAR(15) 
  * default_for_kind : BOOLEAN 
  * status : VARCHAR(15) 
  * created_at : TIMESTAMPTZ 
  * updated_at : TIMESTAMPTZ 
  .. UNIQUE (organization_id, name) ..
}
entity "report_template_shared_users" as report_template_shared_users {
  * report_template_id : BIGINT <<PK>> <<FK>>
  * user_id : BIGINT <<PK>>
  --
}
entity "report_sections" as report_sections {
  * id : BIGINT <<PK>>
  --
  * report_template_id : BIGINT <<FK>>
  * title : VARCHAR(80) 
  * section_order : INTEGER 
  * created_at : TIMESTAMPTZ 
  * updated_at : TIMESTAMPTZ 
  .. UNIQUE (report_template_id, section_order) ..
}
entity "report_widgets" as report_widgets {
  * report_section_id : BIGINT <<PK>> <<FK>>
  * position : INTEGER <<PK>>
  --
  * variable_source : VARCHAR(20) 
  * variable_code : VARCHAR(50) 
  variable_label : VARCHAR(80) 
  * view_type : VARCHAR(15) 
  * aggregation : VARCHAR(10) 
  unit_override_symbol : VARCHAR(15) 
  unit_override_category : VARCHAR(20) 
  * width : VARCHAR(10) 
}
entity "generated_reports" as generated_reports {
  * id : BIGINT <<PK>>
  --
  * report_template_id : BIGINT <<FK>>
  * organization_id : BIGINT 
  * generated_by_user_id : BIGINT 
  * subject_type : VARCHAR(25) 
  subject_id : BIGINT 
  period_from : DATE 
  period_to : DATE 
  * format : VARCHAR(5) 
  storage_key : VARCHAR(200) 
  * generated_at : TIMESTAMPTZ 
  * created_at : TIMESTAMPTZ 
  * updated_at : TIMESTAMPTZ 
}
quality_certificate_sessions }o--|| quality_certificates : quality_certificate_id
quality_certificate_parameter_compliance }o--|| quality_certificates : quality_certificate_id
pcr_compliance_entries }o--|| pcr_compliance_reports : pcr_compliance_report_id
report_template_shared_users }o--|| report_templates : report_template_id
report_sections }o--|| report_templates : report_template_id
report_widgets }o--|| report_sections : report_section_id
generated_reports }o--|| report_templates : report_template_id
}

@enduml
