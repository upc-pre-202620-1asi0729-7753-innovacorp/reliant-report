@startuml Reliant_ClassDiagram

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 60
hide empty members

' ============================================================
' SHARED KERNEL
' ============================================================
package "SharedKernel" #F5F5F5 {

    package "domain" {
        abstract class AuditableModel {
            - id: Long
            - createdAt: Instant
            - updatedAt: Instant
        }
        abstract class AuditableAbstractAggregateRoot {
            + registerEvent(event: Object): void
            + clearDomainEvents(): void
        }
        AuditableModel <|-- AuditableAbstractAggregateRoot

        abstract class IntegrationEvent {
            - eventId: UUID
            - occurredAt: Instant
            - sourceContext: String
            - organizationId: Long
        }

        class PlcTimestamp <<Value Object>> {
            - epochMillis: long
            - plcClockOffsetMillis: long
            + toInstant(): Instant
        }
        class TimeWindow <<Value Object>> {
            - start: Instant
            - end: Instant
            - zone: ZoneId
            + duration(): Duration
            + contains(instant: Instant): boolean
        }
        class ReportingPeriod <<Value Object>> {
            - from: LocalDate
            - to: LocalDate
            - grouping: PeriodGroupingEnum
            + validate(): void
        }
        class SamplingInterval <<Value Object>> {
            - millis: int
            + validate(): void
        }
        enum PeriodGroupingEnum {
            DAILY
            WEEKLY
            MONTHLY
        }
        ReportingPeriod --> PeriodGroupingEnum

        class Unit <<Value Object>> {
            - symbol: String
            - category: UnitCategoryEnum
            - system: UnitSystemEnum
            + validate(): void
        }
        enum UnitCategoryEnum {
            PRESSURE
            TEMPERATURE
            FLOW
            SPEED
            LENGTH
            MASS
            TIME
            RATIO
            DIMENSIONLESS
        }
        enum UnitSystemEnum {
            INTERNATIONAL_SYSTEM
            IMPERIAL_SYSTEM
        }
        interface UnitConversionService <<Domain Service>> {
            + convert(value: BigDecimal, from: Unit, to: Unit): BigDecimal
            + canonicalUnitFor(category: UnitCategoryEnum): Unit
        }
        class StandardUnitConversionService {
            - conversionTable: Map<UnitPair, BigDecimal>
            + convert(value: BigDecimal, from: Unit, to: Unit): BigDecimal
            + canonicalUnitFor(category: UnitCategoryEnum): Unit
        }
        UnitConversionService <|.. StandardUnitConversionService
        Unit --> UnitCategoryEnum
        Unit --> UnitSystemEnum

        class Money <<Value Object>> {
            - amount: BigDecimal
            - currency: Currency
        }
        class Hourmeter <<Value Object>> {
            - hours: BigDecimal
            + minus(other: Hourmeter): Hourmeter
        }
        class Weight <<Value Object>> {
            - value: BigDecimal
            - unit: Unit
        }
        class Ruc <<Value Object>> {
            - value: String
            + validate(): void
        }
        Weight "1" --> "1" Unit : measuredIn
    }

    package "application" {
        interface IntegrationEventPublisher <<Port>> {
            + publish(event: IntegrationEvent): void
        }
    }

    package "infrastructure" {
        class SpringIntegrationEventPublisher <<Adapter>> {
            - applicationEventPublisher: ApplicationEventPublisher
            + publish(event: IntegrationEvent): void
        }
        class SnakeCasePhysicalNamingStrategy <<Persistence>> {
            + toPhysicalTableName(name, context): Identifier
            + toPhysicalColumnName(name, context): Identifier
        }
        class SecurityConfig <<Configuration>> {
            + filterChain(http: HttpSecurity): SecurityFilterChain
        }
        class CorsConfig <<Configuration>> {
            + corsConfigurer(): WebMvcConfigurer
        }
        class OpenApiConfiguration <<Configuration>> {
            + customOpenApi(): OpenAPI
        }
        IntegrationEventPublisher <|.. SpringIntegrationEventPublisher
    }

    package "interfaces" {
        class HealthController <<REST>> {
            + health(): ResponseEntity
        }
        class GlobalExceptionHandler <<REST Advice>> {
            + handleDomainException(ex): ResponseEntity<ErrorResource>
            + handleValidation(ex): ResponseEntity<ErrorResource>
            + handleNotFound(ex): ResponseEntity<ErrorResource>
        }
        class ErrorResource <<Resource>> {
            - code: String
            - message: String
            - timestamp: Instant
        }
        GlobalExceptionHandler ..> ErrorResource
    }
}

' ============================================================
' IAM
' ============================================================
package "IAM" #E8F0FE {

    package "domain" {
        class Organization <<Aggregate Root>> {
            - name: String
            - ruc: Ruc
            - organizationType: OrganizationTypeEnum
            - status: OrganizationStatusEnum
            - timeZone: ZoneId
            + activate(): void
            + suspend(): void
        }
        class User <<Aggregate Root>> {
            - fullName: String
            - email: EmailAddress
            - passwordHash: String
            - organizationId: Long
            - roles: Set<Role>
            + assignRole(role: Role): void
        }
        class UserPreference <<Aggregate Root>> {
            - userId: Long
            - defaultUnitSystem: UnitSystemEnum
            - unitOverrides: List<UnitOverride>
            - language: String
            + overrideUnit(override: UnitOverride): void
            + resolveUnit(category: UnitCategoryEnum, parameter: String): Unit
        }
        class UnitOverride <<Value Object>> {
            - category: UnitCategoryEnum
            - parameter: String
            - unit: Unit
        }
        class Role <<Entity>> {
            - name: RoleEnum
        }
        class EmailAddress <<Value Object>> {
            - value: String
            + validate(): void
        }
        enum OrganizationTypeEnum {
            RECUPERATION_SUPPLIER
            ASSET_OWNER
        }
        enum OrganizationStatusEnum {
            ACTIVE
            SUSPENDED
        }
        enum RoleEnum {
            ROLE_ADMIN
            ROLE_HVOF_OPERATOR
            ROLE_OPERATION_SUPERVISOR
            ROLE_MAINTENANCE_SUPERVISOR
            ROLE_QUALITY_ENGINEER
            ROLE_RELIABILITY_ENGINEER
            ROLE_PROCUREMENT_ANALYST
        }
        class OrganizationRegisteredEvent <<Domain Event>> {
            - organizationId: Long
            - ruc: String
        }
        Organization "1" --> "1" Ruc : identifiedBy
        Organization --> OrganizationTypeEnum
        Organization --> OrganizationStatusEnum
        Organization ..> OrganizationRegisteredEvent : registers
        User "1" --> "1" EmailAddress : contactedAt
        User "1" o-- "1..*" Role : holds
        User "*" --> "1" Organization : belongsTo
        UserPreference "1" --> "1" User : belongsTo
        UserPreference "1" *-- "0..*" UnitOverride : overrides
        UserPreference --> UnitSystemEnum
        UnitOverride "1" --> "1" Unit : uses
        Role --> RoleEnum
    }

    package "application" {
        interface HashingService <<Port>> {
            + hash(raw: String): String
            + matches(raw: String, hashed: String): boolean
        }
        interface TokenService <<Port>> {
            + generateToken(username: String): String
            + validateToken(token: String): boolean
        }
        class UserCommandServiceImpl <<Application Service>> {
            + handle(command: SignUpCommand): Optional<User>
            + handle(command: SignInCommand): Optional<Pair<User, String>>
        }
        class UserPreferenceCommandServiceImpl <<Application Service>> {
            + handle(command: UpdateUnitPreferenceCommand): Optional<UserPreference>
        }
        UserCommandServiceImpl ..> HashingService
        UserCommandServiceImpl ..> TokenService
        UserCommandServiceImpl ..> User
        UserPreferenceCommandServiceImpl ..> UserPreference
    }

    package "infrastructure" {
        class BCryptHashingService <<Adapter>>
        class JwtTokenService <<Adapter>>
        class JwtAuthenticationFilter <<Adapter>>
        HashingService <|.. BCryptHashingService
        TokenService <|.. JwtTokenService
        JwtAuthenticationFilter ..> TokenService
    }

    package "interfaces" {
        class AuthenticationController <<REST>>
        class UserPreferenceController <<REST>>
        class IamContextFacade <<Open Host Service>> {
            + fetchOrganizationIdByRuc(ruc: String): Optional<Long>
            + fetchOrganizationType(organizationId: Long): String
            + fetchOrganizationTimeZone(organizationId: Long): ZoneId
            + fetchUserIdsByRole(organizationId: Long, role: String): List<Long>
            + fetchUserEmail(userId: Long): Optional<String>
            + fetchUnitPreference(userId: Long, category: String, parameter: String): Unit
        }
        class OrganizationRegisteredIntegrationEvent <<Integration Event>> {
            - organizationId: Long
            - ruc: String
            - organizationType: String
        }
        AuthenticationController ..> UserCommandServiceImpl
        UserPreferenceController ..> UserPreferenceCommandServiceImpl
        IamContextFacade ..> Organization
        IamContextFacade ..> User
        IamContextFacade ..> UserPreference
        IntegrationEvent <|-- OrganizationRegisteredIntegrationEvent
    }
}

' ============================================================
' BILLING
' ============================================================
package "Billing" #FFF8E1 {
    package "domain" {
        class Plan <<Aggregate Root>> {
            - name: String
            - planType: PlanTypeEnum
            - monthlyPrice: Money
            - maxMonitoredSystems: Integer
            - maxTrackedComponents: Integer
            + isCompatibleWith(organizationType: String): boolean
        }
        class Subscription <<Aggregate Root>> {
            - organizationId: Long
            - planId: Long
            - startDate: LocalDate
            - endDate: LocalDate
            - status: SubscriptionStatusEnum
            + activate(): void
            + cancel(): void
            + isActive(): boolean
        }
        enum PlanTypeEnum {
            OPERATOR
            ASSET_OWNER
        }
        enum SubscriptionStatusEnum {
            ACTIVE
            CANCELLED
            EXPIRED
        }
        Plan "1" --> "1" Money : pricedAt
        Plan --> PlanTypeEnum
        Subscription "*" --> "1" Plan : subscribedTo
        Subscription --> SubscriptionStatusEnum
    }
    package "application" {
        class "ExternalIamService" as bilExtIam <<ACL>> {
            + fetchOrganizationType(organizationId: Long): Optional<String>
        }
        class SubscriptionCommandServiceImpl <<Application Service>>
        SubscriptionCommandServiceImpl ..> bilExtIam
        SubscriptionCommandServiceImpl ..> Subscription
        bilExtIam ..> IamContextFacade : «ACL»
    }
    package "interfaces" {
        class SubscriptionController <<REST>>
        class BillingContextFacade <<Open Host Service>> {
            + hasActiveSubscription(organizationId: Long): boolean
            + fetchMaxMonitoredSystems(organizationId: Long): Integer
        }
        SubscriptionController ..> SubscriptionCommandServiceImpl
        BillingContextFacade ..> Subscription
    }
}

' ============================================================
' EQUIPMENT
' ============================================================
package "Equipment" #E8F5E9 {

    package "domain" {

        class HVOFSystem <<Aggregate Root>> {
            - code: String
            - organizationId: Long
            - serialNumber: String
            - status: EquipmentStatusEnum
            - systemModel: HvofSystemModel
            - fuelType: FuelTypeEnum
            - subsystems: List<HvofSubsystem>
            - controllers: List<Controller>
            - tagMappings: List<TagMapping>
            - derivedParameters: List<DerivedParameterDefinition>
            + changeStatus(status: EquipmentStatusEnum): void
            + addSubsystem(subsystem: HvofSubsystem): void
            + addController(controller: Controller): void
            + proposeTagMappings(tagPaths: List<String>, rules: List<TagMappingRule>): List<TagMapping>
            + confirmTagMapping(mapping: TagMapping): void
            + defineDerivedParameter(definition: DerivedParameterDefinition): void
            + resolveTag(tagPath: String): Optional<TagMapping>
            + findTagPathByRole(role: StatusRoleEnum): Optional<String>
            + canStartSession(): boolean
        }
        class HvofSubsystem <<Entity>> {
            - subsystemType: HvofSubsystemTypeEnum
            - name: String
            - alias: String
            - parameters: Set<ProcessParameterEnum>
            - parts: List<HvofPart>
            + addPart(part: HvofPart): void
        }
        class HvofPart <<Entity>> {
            - partType: HvofPartTypeEnum
            - serialNumber: String
            - manufacturer: String
        }
        class Controller <<Entity>> {
            - controllerNumber: Integer
            - deviceType: DeviceTypeEnum
            - serialNumber: String
            - deviceInfo: DeviceInfo
            - endpoint: NetworkEndpoint
            - tagCatalogId: Long
        }
        class DerivedParameterDefinition <<Entity>> {
            - name: String
            - parameter: ProcessParameterEnum
            - expression: String
            - inputTagPaths: List<String>
            - unit: Unit
            + validateExpression(): void
        }
        class HvofSystemModel <<Value Object>> {
            - manufacturer: String
            - model: String
        }
        class DeviceInfo <<Value Object>> {
            - manufacturer: ControllerManufacturerEnum
            - model: String
            - partNumber: String
            - supportedProtocols: Set<ProtocolEnum>
            + validatePartNumber(): void
        }
        class NetworkEndpoint <<Value Object>> {
            - ipAddress: IpAddressV4
            - port: Integer
            - rack: Integer
            - slot: Integer
            - endpointUrl: String
            + validateFor(protocol: ProtocolEnum): void
        }

        class IpAddressV4 <<Value Object>> {
            - value: String
            + {static} of(value: String): IpAddressV4
            + octets(): int[]
            + isPrivate(): boolean
            + isLoopback(): boolean
            + isInSameSubnetAs(other: IpAddressV4, prefixLength: int): boolean
            + toString(): String
        }

        class TagMapping <<Value Object>> {
            - tagPath: String
            - controllerId: Long
            - subsystemId: Long
            - partId: Long
            - parameter: ProcessParameterEnum
            - tagKind: TagKindEnum
            - statusRole: StatusRoleEnum
            - matchedRuleId: Long
            - confirmed: boolean
        }

        ' ---- Receta: setpoints y bandas de umbral ----
        class Recipe <<Aggregate Root>> {
            - hvofSystemId: Long
            - recipeNumber: Integer
            - name: String
            - powderSpecification: String
            - applicability: List<RecipeApplicability>
            - parameters: List<RecipeParameter>
            - status: RecipeStatusEnum
            + defineParameter(parameter: RecipeParameter): void
            + addApplicability(applicability: RecipeApplicability): void
            + appliesTo(componentType: String, machineModel: String): boolean
            + limitsFor(parameter: ProcessParameterEnum): Optional<ParameterLimits>
            + approve(): void
        }
        class RecipeApplicability <<Value Object>> {
            - componentType: String
            - machineModel: String
            - position: String
        }
        class RecipeParameter <<Value Object>> {
            - parameter: ProcessParameterEnum
            - setpoint: BigDecimal
            - limits: ParameterLimits
            - unit: Unit
        }
        class ParameterLimits <<Value Object>> {
            - lowerShutdown: BigDecimal
            - lowerWarning: BigDecimal
            - nominalMin: BigDecimal
            - nominalMax: BigDecimal
            - upperWarning: BigDecimal
            - upperShutdown: BigDecimal
            + validateOrder(): void
            + bandFor(value: BigDecimal): ThresholdBandEnum
        }

        ' ---- Catálogo de tags: un aggregate por controlador ----
        class ControllerTagCatalog <<Aggregate Root>> {
            - controllerId: Long
            - manufacturer: ControllerManufacturerEnum
            - importedAt: Instant
            - roots: List<TagNode>
            + rebuildFrom(rows: List<ImportedTagRow>, normalizer: DataTypeNormalizer): void
            + findByPath(tagPath: String): Optional<TagNode>
            + leaves(): List<TagNode>
        }
        class TagNode <<Entity>> {
            - name: String
            - kind: TagNodeKindEnum
            - vendorDataType: String
            - dataType: CanonicalDataTypeEnum
            - style: DisplayStyleEnum
            - description: String
            - children: List<TagNode>
            + tagPath(): String
            + isLeaf(): boolean
        }
        class ImportedTagRow <<Value Object>> {
            - scope: String
            - name: String
            - vendorDataType: String
            - description: String
            - attributes: String
        }
        interface DataTypeNormalizer <<Domain Service>> {
            + supports(manufacturer: ControllerManufacturerEnum): boolean
            + normalize(vendorDataType: String): CanonicalDataTypeEnum
        }
        class AllenBradleyDataTypeNormalizer
        class SiemensDataTypeNormalizer
        class SchneiderDataTypeNormalizer
        class MitsubishiDataTypeNormalizer
        class DeltaDataTypeNormalizer
        class OmronDataTypeNormalizer
        DataTypeNormalizer <|.. AllenBradleyDataTypeNormalizer
        DataTypeNormalizer <|.. SiemensDataTypeNormalizer
        DataTypeNormalizer <|.. SchneiderDataTypeNormalizer
        DataTypeNormalizer <|.. MitsubishiDataTypeNormalizer
        DataTypeNormalizer <|.. DeltaDataTypeNormalizer
        DataTypeNormalizer <|.. OmronDataTypeNormalizer

        class TagMappingRule <<Aggregate Root>> {
            - pattern: String
            - subsystemType: HvofSubsystemTypeEnum
            - partType: HvofPartTypeEnum
            - parameter: ProcessParameterEnum
            - tagKind: TagKindEnum
            - statusRole: StatusRoleEnum
            - priority: Integer
            + matches(tagPath: String): boolean
        }

        enum EquipmentStatusEnum {
            ACTIVE
            IN_MAINTENANCE
            OUT_OF_SERVICE
        }
        enum FuelTypeEnum {
            KEROSENE
            PROPANE
            PROPYLENE
            HYDROGEN
            NATURAL_GAS
        }
        enum HvofSubsystemTypeEnum {
            SPRAY_GUN
            GAS_CONTROL_CONSOLE
            POWDER_FEED
            COOLING
            FUEL_SUPPLY
            OXYGEN_SUPPLY
            COMPRESSED_AIR
            GUN_MANIPULATION
            WORKPIECE_HANDLING
            ENCLOSURE_VENTILATION
            DUST_COLLECTION
            GAS_DETECTION
            CONTROL_AND_SAFETY
        }
        enum HvofPartTypeEnum {
            COMBUSTION_CHAMBER
            NOZZLE
            INJECTOR
            HOPPER
            METERING_DISC
            VIBRATOR
            CHILLER
            WATER_PUMP
            FUEL_PUMP
            REGULATOR
            MASS_FLOW_CONTROLLER
            X_AXIS
            Z_AXIS
            SPINDLE
            TURNTABLE
            DUST_COLLECTOR
            FILTER
            DOOR_INTERLOCK
            GAS_SENSOR
        }
        enum DeviceTypeEnum {
            PLC
            HMI
            VFD
            REMOTE_IO
        }
        enum ControllerManufacturerEnum {
            ALLEN_BRADLEY
            SIEMENS
            SCHNEIDER
            MITSUBISHI
            DELTA
            OMRON
            OTHER
        }
        enum ProtocolEnum {
            ETHERNET_IP
            S7
            OPC_UA
            MODBUS_TCP
        }
        enum TagNodeKindEnum {
            PROGRAM
            STRUCTURE
            ARRAY
            ATOMIC
        }
        enum CanonicalDataTypeEnum {
            BOOLEAN
            INTEGER
            FLOAT
            STRING
            STRUCTURE
            ARRAY
        }
        enum DisplayStyleEnum {
            DECIMAL
            FLOAT
            BINARY
            HEX
            ASCII
        }
        enum TagKindEnum {
            ANALOG_READING
            SETPOINT
            FAULT_FLAG
            STATUS
        }
        enum StatusRoleEnum {
            NONE
            MACHINE_RUNNING
            GUN_IGNITED
            FEEDER_RUNNING
            SPRAY_ACTIVE
            RECIPE_NUMBER
        }
        enum RecipeStatusEnum {
            DRAFT
            APPROVED
            RETIRED
        }
        enum ThresholdBandEnum {
            NOMINAL
            WARNING_LOW
            WARNING_HIGH
            SHUTDOWN_LOW
            SHUTDOWN_HIGH
        }
        enum ProcessParameterEnum {
            OXYGEN_PRESSURE
            OXYGEN_FLOW
            FUEL_PRESSURE
            FUEL_FLOW
            OXYGEN_FUEL_RATIO
            CARRIER_GAS_PRESSURE
            CARRIER_GAS_FLOW
            FLAME_TEMPERATURE
            POWDER_FEEDRATE
            FEEDER_DISC_SPEED
            HOPPER_PRESSURE
            COOLING_WATER_FLOW
            COOLING_WATER_INLET_TEMPERATURE
            COOLING_WATER_PRESSURE
            SPINDLE_SPEED
            X_AXIS_POSITION
            Z_AXIS_POSITION
            TRAVERSE_SPEED
            AIR_PRESSURE
            DUST_COLLECTOR_DIFFERENTIAL_PRESSURE
        }

        HVOFSystem "1" *-- "1..*" HvofSubsystem : composedOf
        HVOFSystem "1" *-- "1..*" Controller : controlledBy
        HVOFSystem "1" *-- "0..*" TagMapping : maps
        HVOFSystem "1" *-- "0..*" DerivedParameterDefinition : computes
        HVOFSystem "1" --> "1" HvofSystemModel : is
        HVOFSystem --> EquipmentStatusEnum
        HVOFSystem --> FuelTypeEnum
        HVOFSystem ..> TagMappingRule : evaluates
        Recipe "1..*" --> "1" HVOFSystem : loadedIn (por id)
        HvofSubsystem "1" *-- "0..*" HvofPart : contains
        HvofSubsystem --> HvofSubsystemTypeEnum
        HvofPart --> HvofPartTypeEnum
        Controller "1" --> "1" DeviceInfo : describedBy
        Controller "1" --> "1" NetworkEndpoint : reachableAt
        Controller --> DeviceTypeEnum
        Controller ..> ControllerTagCatalog : catalogedBy (por id)
        DeviceInfo --> ControllerManufacturerEnum
        DeviceInfo --> ProtocolEnum
        DerivedParameterDefinition --> ProcessParameterEnum
        DerivedParameterDefinition "1" --> "1" Unit : expressedIn
        TagMapping --> ProcessParameterEnum
        TagMapping --> TagKindEnum
        TagMapping --> StatusRoleEnum
        Recipe "1" *-- "1..*" RecipeParameter : defines
        Recipe "1" *-- "1..*" RecipeApplicability : appliesTo
        Recipe --> RecipeStatusEnum
        RecipeParameter "1" --> "1" ParameterLimits : boundedBy
        RecipeParameter --> ProcessParameterEnum
        RecipeParameter "1" --> "1" Unit : expressedIn
        ParameterLimits ..> ThresholdBandEnum : classifies
        ControllerTagCatalog "1" *-- "1..*" TagNode : roots
        ControllerTagCatalog ..> ImportedTagRow : builtFrom
        ControllerTagCatalog ..> DataTypeNormalizer : uses
        TagNode "1" *-- "0..*" TagNode : children
        TagNode --> TagNodeKindEnum
        TagNode --> CanonicalDataTypeEnum
        TagNode --> DisplayStyleEnum
        TagMappingRule --> HvofSubsystemTypeEnum
        TagMappingRule --> TagKindEnum
        TagMappingRule --> StatusRoleEnum
        NetworkEndpoint "1" --> "1" IpAddressV4 : has
    }

    package "application" {
        class "ExternalBillingService" as eqExtBilling <<ACL>> {
            + canRegisterAnotherSystem(organizationId: Long): boolean
        }
        class HvofSystemCommandServiceImpl <<Application Service>> {
            + handle(command: RegisterHvofSystemCommand): Optional<HVOFSystem>
            + handle(command: ImportControllerTagsCommand): List<TagMapping>
            + handle(command: ConfirmTagMappingCommand): Optional<HVOFSystem>
            + handle(command: DefineDerivedParameterCommand): Optional<HVOFSystem>
        }
        class RecipeCommandServiceImpl <<Application Service>> {
            + handle(command: CreateRecipeCommand): Optional<Recipe>
            + handle(command: ApproveRecipeCommand): Optional<Recipe>
        }
        HvofSystemCommandServiceImpl ..> eqExtBilling
        HvofSystemCommandServiceImpl ..> HVOFSystem
        HvofSystemCommandServiceImpl ..> ControllerTagCatalog
        RecipeCommandServiceImpl ..> Recipe
        eqExtBilling ..> BillingContextFacade : «ACL»
    }

    package "infrastructure" {
        interface TagFileParser <<Port>> {
            + parse(file: MultipartFile): List<ImportedTagRow>
        }
        class Studio5000CsvTagFileParser <<Adapter>>
        class JsonTagFileParser <<Adapter>>
        TagFileParser <|.. Studio5000CsvTagFileParser
        TagFileParser <|.. JsonTagFileParser
        HvofSystemCommandServiceImpl ..> TagFileParser
    }

    package "interfaces" {
        class HvofSystemController <<REST>>
        class RecipeController <<REST>>
        class EquipmentContextFacade <<Open Host Service>> {
            + isSystemActive(systemId: Long): boolean
            + resolveTag(systemId: Long, tagPath: String): Optional<ResolvedTagDto>
            + fetchTagPathByRole(systemId: Long, role: String): Optional<String>
            + fetchRecipeLimits(systemId: Long, recipeNumber: Integer): List<ParameterLimitsDto>
            + recipeAppliesTo(systemId: Long, recipeNumber: Integer, componentType: String, machineModel: String): boolean
            + fetchDerivedParameters(systemId: Long): List<DerivedParameterDto>
            + fetchSubsystemAndPart(systemId: Long, subsystemId: Long, partId: Long): Optional<SubsystemPartDto>
            + fetchAvailableVariables(systemId: Long): List<VariableDto>
        }
        HvofSystemController ..> HvofSystemCommandServiceImpl
        RecipeController ..> RecipeCommandServiceImpl
        EquipmentContextFacade ..> HVOFSystem
        EquipmentContextFacade ..> Recipe
    }
}

