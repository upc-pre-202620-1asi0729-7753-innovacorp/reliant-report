@startuml Reliant_Reporting_Full
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 60
hide empty members

package "SharedKernel" #F5F5F5 {

    package "shared.domain" {
        abstract class AuditableModel {
            - id: Long
            - createdAt: Instant
            - updatedAt: Instant
        }
        abstract class AuditableAbstractAggregateRoot {
            + registerEvent(event: Object): void
            + clearDomainEvents(): void
        }
        AuditableModel <|-- AuditableAbstractAggregateRoot

        abstract class IntegrationEvent {
            - eventId: UUID
            - occurredAt: Instant
            - sourceContext: String
            - organizationId: Long
        }

        class ReportingPeriod <<Value Object>> {
            - from: LocalDate
            - to: LocalDate
            - grouping: PeriodGroupingEnum
            + validate(): void
        }
        enum PeriodGroupingEnum {
            DAILY
            WEEKLY
            MONTHLY
        }
        ReportingPeriod --> PeriodGroupingEnum

        class Unit <<Value Object>> {
            - symbol: String
            - category: UnitCategoryEnum
            - system: UnitSystemEnum
            + validate(): void
        }
        enum UnitCategoryEnum {
            PRESSURE
            TEMPERATURE
            FLOW
            SPEED
            LENGTH
            MASS
            TIME
            RATIO
            DIMENSIONLESS
        }
        enum UnitSystemEnum {
            INTERNATIONAL_SYSTEM
            IMPERIAL_SYSTEM
        }
        Unit --> UnitCategoryEnum
        Unit --> UnitSystemEnum

    }

    package "shared.application" {
        interface UnitConversionService <<Port>> {
            + convert(value: BigDecimal, from: Unit, to: Unit): BigDecimal
            + canonicalUnitFor(category: UnitCategoryEnum): Unit
        }
    }

    package "shared.infrastructure" {
        class StandardUnitConversionService <<Adapter>> {
            - conversionTable: Map<UnitPair, BigDecimal>
            + convert(value: BigDecimal, from: Unit, to: Unit): BigDecimal
            + canonicalUnitFor(category: UnitCategoryEnum): Unit
        }
        UnitConversionService <|.. StandardUnitConversionService
    }

}

package "Reporting" #F1F8E9 {

    package "reporting.domain" {
        class ReportingEvent <<Aggregate Root>> {
            - eventType: String
            - sourceContext: String
            - aggregateId: Long
            - organizationId: Long
            - occurredAt: Instant
            - payload: String
        }
        class QualityCertificate <<Aggregate Root>> {
            - recuperationId: Long
            - componentId: Long
            - customerId: Long
            - supplierOrganizationId: Long
            - sessionIds: List<Long>
            - issuedByUserId: Long
            - issuedAt: Instant
            - parameterCompliance: List<ParameterComplianceSummary>
            - justification: String
            - status: CertificateStatusEnum
            + issue(justification: Optional<String>): void
            + isFullyCompliant(): boolean
        }
        class ParameterComplianceSummary <<Value Object>> {
            - parameter: String
            - minObserved: BigDecimal
            - maxObserved: BigDecimal
            - withinNominal: boolean
        }
        class PcrComplianceReport <<Aggregate Root>> {
            - organizationId: Long
            - period: ReportingPeriod
            - groupedBy: ReportGroupingEnum
            - entries: List<PcrComplianceEntry>
            + complianceRate(): BigDecimal
        }
        class PcrComplianceEntry <<Value Object>> {
            - groupKey: String
            - totalComponents: Integer
            - metPcrCount: Integer
            - prematureFailureCount: Integer
        }
        enum CertificateStatusEnum {
            DRAFT
            ISSUED
            REVOKED
        }
        enum ReportGroupingEnum {
            BY_SUPPLIER
            BY_CUSTOMER
            BY_MACHINE_MODEL
            BY_COMPONENT_TYPE
        }
        QualityCertificate "1" *-- "1..*" ParameterComplianceSummary : summarizes
        QualityCertificate --> CertificateStatusEnum
        PcrComplianceReport "1" *-- "1..*" PcrComplianceEntry : aggregates
        PcrComplianceReport "1" --> "1" ReportingPeriod : covers
        PcrComplianceReport --> ReportGroupingEnum

        class ReportTemplate <<Aggregate Root>> {
            - organizationId: Long
            - ownerUserId: Long
            - name: String
            - description: String
            - reportKind: ReportKindEnum
            - branding: Branding
            - layout: Layout
            - sections: List<ReportSection>
            - visibility: TemplateVisibilityEnum
            - sharedWithUserIds: Set<Long>
            - defaultForKind: boolean
            - status: TemplateStatusEnum
            + addSection(section: ReportSection): void
            + reorderSections(order: List<Long>): void
            + shareWithOrganization(): void
            + shareWith(userId: Long): void
            + markAsDefault(): void
            + publish(): void
            + isAccessibleBy(userId: Long, organizationId: Long): boolean
        }
        class ReportSection <<Entity>> {
            - title: String
            - order: Integer
            - widgets: List<ReportWidget>
            + addWidget(widget: ReportWidget): void
        }
        class ReportWidget <<Value Object>> {
            - variable: ReportVariable
            - viewType: ViewTypeEnum
            - aggregation: AggregationEnum
            - unitOverride: Unit
            - position: Integer
            - width: WidgetWidthEnum
        }
        class ReportVariable <<Value Object>> {
            - source: VariableSourceEnum
            - code: String
            - label: String
        }
        class Branding <<Value Object>> {
            - logoAssetKey: String
            - primaryColor: String
            - secondaryColor: String
            - headerText: String
            - footerText: String
        }
        class Layout <<Value Object>> {
            - pageSize: PageSizeEnum
            - orientation: OrientationEnum
            - columns: Integer
            - showSignatureBlock: boolean
        }
        class GeneratedReport <<Aggregate Root>> {
            - templateId: Long
            - organizationId: Long
            - generatedByUserId: Long
            - subjectType: ReportKindEnum
            - subjectId: Long
            - period: ReportingPeriod
            - format: ReportFormatEnum
            - storageKey: String
            - generatedAt: Instant
            + markStored(storageKey: String): void
        }
        class ReportTemplateSharedEvent <<Domain Event>> {
            - templateId: Long
            - organizationId: Long
        }
        enum ReportKindEnum {
            SESSION_REPORT
            QUALITY_CERTIFICATE
            FAULT_FREQUENCY
            PCR_COMPLIANCE
            SUPPLIER_PERFORMANCE
        }
        enum VariableSourceEnum {
            PROCESS_PARAMETER
            DERIVED_PARAMETER
            METRIC
        }
        enum ViewTypeEnum {
            LINE_CHART
            BAR_CHART
            GAUGE
            TABLE
            KPI_CARD
            MIN_MAX_AVG
            BAND_TIMELINE
        }
        enum AggregationEnum {
            RAW
            AVG
            MIN
            MAX
            COUNT
        }
        enum WidgetWidthEnum {
            THIRD
            HALF
            FULL
        }
        enum PageSizeEnum {
            A4
            LETTER
        }
        enum OrientationEnum {
            PORTRAIT
            LANDSCAPE
        }
        enum TemplateVisibilityEnum {
            PRIVATE
            ORGANIZATION
        }
        enum TemplateStatusEnum {
            DRAFT
            PUBLISHED
            ARCHIVED
        }
        enum ReportFormatEnum {
            PDF
            CSV
        }
        ReportTemplate "1" *-- "1..*" ReportSection : composedOf
        ReportTemplate "1" --> "1" Branding : styledWith
        ReportTemplate "1" --> "1" Layout : laidOutAs
        ReportTemplate --> ReportKindEnum
        ReportTemplate --> TemplateVisibilityEnum
        ReportTemplate --> TemplateStatusEnum
        ReportTemplate ..> ReportTemplateSharedEvent : registers
        ReportSection "1" *-- "1..*" ReportWidget : shows
        ReportWidget "1" --> "1" ReportVariable : plots
        ReportWidget "0..1" --> "1" Unit : unitOverride
        ReportWidget --> ViewTypeEnum
        ReportWidget --> AggregationEnum
        ReportWidget --> WidgetWidthEnum
        ReportVariable --> VariableSourceEnum
        Layout --> PageSizeEnum
        Layout --> OrientationEnum
        GeneratedReport "*" --> "1" ReportTemplate : renderedFrom
        GeneratedReport "1" --> "1" ReportingPeriod : covers
        GeneratedReport --> ReportFormatEnum

        interface ReportingEventRepository <<Repository>> {
            + findByOrganizationIdAndOccurredAtBetween(organizationId: Long, from: Instant, to: Instant): List<ReportingEvent>
            + save(event: ReportingEvent): ReportingEvent
        }
        interface QualityCertificateRepository <<Repository>> {
            + findByRecuperationId(recuperationId: Long): Optional<QualityCertificate>
            + save(certificate: QualityCertificate): QualityCertificate
        }
        interface PcrComplianceReportRepository <<Repository>> {
            + save(report: PcrComplianceReport): PcrComplianceReport
        }
        interface ReportTemplateRepository <<Repository>> {
            + findAccessibleBy(userId: Long, organizationId: Long): List<ReportTemplate>
            + findByOrganizationIdAndReportKindAndDefaultForKindTrue(organizationId: Long, kind: ReportKindEnum): Optional<ReportTemplate>
            + save(template: ReportTemplate): ReportTemplate
        }
        interface GeneratedReportRepository <<Repository>> {
            + findByTemplateId(templateId: Long): List<GeneratedReport>
            + save(report: GeneratedReport): GeneratedReport
        }
    }

    package "reporting.application" {
        class "ExternalProcessMonitoringService" as rpExtPm <<ACL>> {
            + fetchOutOfRangeSummary(sessionIds: List<Long>): List<ParameterComplianceSummary>
        }
        class "ExternalTraceabilityService" as rpExtTrace <<ACL>> {
            + fetchLinkedSessionIds(recuperationId: Long): List<Long>
        }
        class "ExternalFaultDiagnosisService" as rpExtFd <<ACL>> {
            + fetchFaultCountBySession(sessionId: Long): Integer
        }
        class "ExternalIamService" as rpExtIam <<ACL>> {
            + resolveUnitFor(userId: Long, parameter: String): Unit
            + belongsToOrganization(userId: Long, organizationId: Long): boolean
        }
        class "ExternalEquipmentService" as rpExtEquip <<ACL>> {
            + fetchAvailableVariables(systemId: Long): List<ReportVariable>
        }
        interface ReportRenderer <<Port>> {
            + render(template: ReportTemplate, data: ReportDataSet, format: ReportFormatEnum): byte[]
        }
        interface ReportAssetStoragePort <<Port>> {
            + store(content: byte[], contentType: String): String
            + load(storageKey: String): byte[]
        }
        class ReportDataSet <<Value Object>> {
            - series: Map<ReportVariable, List<DataPoint>>
            - metrics: Map<String, BigDecimal>
        }
        class ReportQueryServiceImpl <<Application Service>> {
            + handle(query: GetAccessibleTemplatesQuery): List<ReportTemplate>
            + handle(query: GetQualityCertificateByRecuperationQuery): Optional<QualityCertificate>
            + handle(query: GetPcrComplianceReportQuery): PcrComplianceReport
        }
        ReportQueryServiceImpl ..> ReportTemplateRepository
        ReportQueryServiceImpl ..> QualityCertificateRepository
        ReportQueryServiceImpl ..> PcrComplianceReportRepository
        class QualityCertificateCommandServiceImpl <<Application Service>>
        class ReportTemplateCommandServiceImpl <<Application Service>> {
            + handle(command: CreateReportTemplateCommand): Optional<ReportTemplate>
            + handle(command: UpdateTemplateSectionsCommand): Optional<ReportTemplate>
            + handle(command: ShareReportTemplateCommand): Optional<ReportTemplate>
            + handle(command: UploadTemplateLogoCommand): Optional<ReportTemplate>
        }
        class ReportGenerationServiceImpl <<Application Service>> {
            + handle(command: GenerateReportCommand): Optional<GeneratedReport>
            - collectData(template: ReportTemplate, subjectId: Long): ReportDataSet
            - resolveUnit(widget: ReportWidget, userId: Long): Unit
        }
        class "ReportingIntegrationEventHandler" as rpHandler <<Event Handler>> {
            + on(event: IntegrationEvent): void
        }
        rpHandler ..> ReportingEvent
        QualityCertificateCommandServiceImpl ..> rpExtPm
        QualityCertificateCommandServiceImpl ..> rpExtTrace
        QualityCertificateCommandServiceImpl ..> rpExtFd
        QualityCertificateCommandServiceImpl ..> QualityCertificate
        ReportTemplateCommandServiceImpl ..> ReportTemplate
        ReportTemplateCommandServiceImpl ..> ReportAssetStoragePort
        ReportTemplateCommandServiceImpl ..> rpExtIam
        ReportTemplateCommandServiceImpl ..> rpExtEquip
        ReportGenerationServiceImpl ..> ReportTemplate
        ReportGenerationServiceImpl ..> GeneratedReport
        ReportGenerationServiceImpl ..> ReportDataSet
        ReportGenerationServiceImpl ..> ReportRenderer
        ReportGenerationServiceImpl ..> ReportAssetStoragePort
        ReportGenerationServiceImpl ..> UnitConversionService
        ReportGenerationServiceImpl ..> rpExtPm
        ReportGenerationServiceImpl ..> rpExtTrace
        ReportGenerationServiceImpl ..> rpExtFd
        ReportGenerationServiceImpl ..> rpExtIam
        rpExtIam ..> IamContextFacade : «ACL»
        rpExtEquip ..> EquipmentContextFacade : «ACL»
        rpExtPm ..> ProcessMonitoringContextFacade : «ACL»
        rpExtTrace ..> TraceabilityContextFacade : «ACL»
        rpExtFd ..> FaultDiagnosisContextFacade : «ACL»
    }

    package "reporting.infrastructure" {
        class PdfReportRenderer <<Adapter>> {
            + render(template, data, format): byte[]
        }
        class CsvReportRenderer <<Adapter>> {
            + render(template, data, format): byte[]
        }
        class FileSystemAssetStorageAdapter <<Adapter>> {
            - basePath: String
            + store(content: byte[], contentType: String): String
            + load(storageKey: String): byte[]
        }
        ReportRenderer <|.. PdfReportRenderer
        ReportRenderer <|.. CsvReportRenderer
        ReportAssetStoragePort <|.. FileSystemAssetStorageAdapter

        interface JpaReportingEventRepository <<Spring Data>>
        interface JpaQualityCertificateRepository <<Spring Data>>
        interface JpaPcrComplianceReportRepository <<Spring Data>>
        interface JpaReportTemplateRepository <<Spring Data>>
        interface JpaGeneratedReportRepository <<Spring Data>>
        ReportingEventRepository <|-- JpaReportingEventRepository
        QualityCertificateRepository <|-- JpaQualityCertificateRepository
        PcrComplianceReportRepository <|-- JpaPcrComplianceReportRepository
        ReportTemplateRepository <|-- JpaReportTemplateRepository
        GeneratedReportRepository <|-- JpaGeneratedReportRepository
    }

    package "reporting.interfaces" {
        class QualityCertificateController <<REST>>
        class PcrComplianceReportController <<REST>>
        class ReportTemplateController <<REST>> {
            + create(resource): ResponseEntity
            + updateSections(templateId, resource): ResponseEntity
            + uploadLogo(templateId, file): ResponseEntity
            + share(templateId, resource): ResponseEntity
            + listAccessible(): ResponseEntity
        }
        class GeneratedReportController <<REST>> {
            + generate(resource): ResponseEntity
            + download(reportId, format): ResponseEntity
        }
        QualityCertificateController ..> QualityCertificateCommandServiceImpl
        QualityCertificateController ..> ReportQueryServiceImpl
        ReportTemplateController ..> ReportQueryServiceImpl
        PcrComplianceReportController ..> ReportQueryServiceImpl
        ReportTemplateController ..> ReportTemplateCommandServiceImpl
        GeneratedReportController ..> ReportGenerationServiceImpl
        rpHandler ..> ReportingEventRepository
        QualityCertificateCommandServiceImpl ..> QualityCertificateRepository
        ReportTemplateCommandServiceImpl ..> ReportTemplateRepository
        ReportGenerationServiceImpl ..> ReportTemplateRepository
        ReportGenerationServiceImpl ..> GeneratedReportRepository
    }
}

package "Equipment" #EEEEEE {
    class EquipmentContextFacade <<Context Facade>>
}
package "FaultDiagnosis" #EEEEEE {
    class FaultDiagnosisContextFacade <<Context Facade>>
}
package "IAM" #EEEEEE {
    class IamContextFacade <<Context Facade>>
}
package "ProcessMonitoring" #EEEEEE {
    class ProcessMonitoringContextFacade <<Context Facade>>
}
package "Traceability" #EEEEEE {
    class TraceabilityContextFacade <<Context Facade>>
}

IntegrationEvent ..> rpHandler : allConsumedBy
AuditableAbstractAggregateRoot <|-- ReportingEvent
AuditableAbstractAggregateRoot <|-- QualityCertificate
AuditableAbstractAggregateRoot <|-- PcrComplianceReport
AuditableAbstractAggregateRoot <|-- ReportTemplate
AuditableAbstractAggregateRoot <|-- GeneratedReport
AuditableModel <|-- ReportSection

@enduml
