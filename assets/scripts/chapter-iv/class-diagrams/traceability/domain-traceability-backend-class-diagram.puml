@startuml Reliant_Traceability_Domain
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 60
hide empty members



package "Traceability" #FCE4EC {

    package "traceability.domain" {
        class Customer <<Aggregate Root>> {
            - supplierOrganizationId: Long
            - linkedAssetOwnerOrganizationId: Long
            - legalName: String
            - ruc: Ruc
            - mineSite: String
            + linkToAssetOwner(organizationId: Long): void
        }
        class Component <<Aggregate Root>> {
            - serialNumber: String
            - partNumber: String
            - componentType: ComponentTypeEnum
            - machineModel: MachineModel
            - customerId: Long
            - pcrTarget: PcrTarget
            - status: ComponentStatusEnum
            - serviceLifeRecords: List<ServiceLifeRecord>
            + deliver(hourmeterAtDelivery: Hourmeter): void
            + registerFieldReturn(record: ServiceLifeRecord): void
        }
        class ServiceLifeRecord <<Entity>> {
            - recuperationId: Long
            - hoursAtDelivery: Hourmeter
            - hoursAtReturn: Hourmeter
            - returnReason: String
            - metPcr: boolean
            + evaluateAgainst(target: PcrTarget): void
        }
        class Recuperation <<Aggregate Root>> {
            - workOrderNumber: WorkOrderNumber
            - manufacturingOrderNumber: ManufacturingOrderNumber
            - componentId: Long
            - customerId: Long
            - supplierOrganizationId: Long
            - segment: String
            - operation: String
            - weight: Weight
            - hourmeterAtEntry: Hourmeter
            - powderLot: PowderLot
            - linkedSessionIds: List<Long>
            - status: RecuperationStatusEnum
            + linkSpraySession(sessionId: Long): void
            + close(): void
        }
        class WorkOrderNumber <<Value Object>> {
            - value: String
            + validate(): void
        }
        class ManufacturingOrderNumber <<Value Object>> {
            - value: String
            + validate(): void
        }
        class MachineModel <<Value Object>> {
            - manufacturer: MachineManufacturerEnum
            - model: String
        }
        class PcrTarget <<Value Object>> {
            - targetHours: Hourmeter
            + isMetBy(achieved: Hourmeter): boolean
        }
        class PowderLot <<Value Object>> {
            - supplier: String
            - lotNumber: String
            - chemicalComposition: String
        }
        class PrematureFailureDetectedEvent <<Domain Event>> {
            - componentId: Long
            - recuperationId: Long
        }
        enum ComponentTypeEnum {
            FRONT_ROD
            CYLINDER_BLOCK
            ROD_ASSEMBLY
            REAR_CYLINDER
        }
        enum ComponentStatusEnum {
            RECEIVED
            IN_PROCESS
            COATED
            DELIVERED
            RETURNED
        }
        enum RecuperationStatusEnum {
            RECEIVED
            IN_PROCESS
            COATED
            CLOSED
        }
        enum MachineManufacturerEnum {
            CATERPILLAR
            KOMATSU
        }
        Customer "1" --> "1" Ruc : identifiedBy
        Component "*" --> "1" Customer : ownedBy
        Component "1" --> "1" MachineModel : fitsIn
        Component "1" --> "1" PcrTarget : expectedToLast
        Component "1" *-- "0..*" ServiceLifeRecord : tracks
        Component --> ComponentTypeEnum
        Component --> ComponentStatusEnum
        Component ..> PrematureFailureDetectedEvent : registers
        Recuperation "*" --> "1" Component : recovers
        Recuperation "*" --> "1" Customer : requestedBy
        Recuperation "1" --> "1" WorkOrderNumber : identifiedBy
        Recuperation "1" --> "1" ManufacturingOrderNumber : identifiedBy
        Recuperation "1" --> "1" PowderLot : sprayedWith
        Recuperation "1" --> "1" Weight : weighs
        Recuperation --> RecuperationStatusEnum
        MachineModel --> MachineManufacturerEnum

        interface CustomerRepository <<Repository>> {
            + findByRuc(ruc: Ruc): Optional<Customer>
            + findBySupplierOrganizationId(organizationId: Long): List<Customer>
            + save(customer: Customer): Customer
        }
        interface ComponentRepository <<Repository>> {
            + findBySerialNumberAndCustomerId(serialNumber: String, customerId: Long): Optional<Component>
            + findByCustomerIdAndStatus(customerId: Long, status: ComponentStatusEnum): List<Component>
            + save(component: Component): Component
        }
        interface RecuperationRepository <<Repository>> {
            + findByWorkOrderNumber(wo: WorkOrderNumber): Optional<Recuperation>
            + existsByManufacturingOrderNumber(of: ManufacturingOrderNumber): boolean
            + findByComponentId(componentId: Long): List<Recuperation>
            + save(recuperation: Recuperation): Recuperation
        }
    }


}



@enduml
