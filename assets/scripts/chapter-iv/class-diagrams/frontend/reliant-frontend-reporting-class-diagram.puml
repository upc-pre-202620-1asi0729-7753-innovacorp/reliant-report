left to right direction

package "Domain" {
  class GeneratedReport {
    id: number
    reportTemplateId: number
    organizationId: number
    generatedByUserId: number
    subjectType: ReportSubjectType
    subjectId: number
    format: string
    fileName: string
    periodFrom: string | null
    periodTo: string | null
    generatedAt: string
  }
  enum ReportSubjectType {
    spray_session
    recuperation
  }
  class ReportTemplate {
    id: number
    organizationId: number
    ownerUserId: number
    name: string
    description: string
    reportKind: ReportKind
    primaryColor: string
    secondaryColor: string
    headerText: string
    footerText: string
    pageSize: PageSize
    orientation: PageOrientation
    showSignatureBlock: boolean
    defaultForKind: boolean
    status: TemplateStatus
    sections: ReportSection[]
    orderedSections: ReportSection[]
    widgetCount: number
    ...
  }
  interface ReportWidget {
    position: number
    variableSource: VariableSource
    variableCode: string
    variableLabel: string
    viewType: WidgetViewType
    aggregation: Aggregation
    width: WidgetWidth
  }
  interface ReportSection {
    title: string
    sectionOrder: number
    widgets: ReportWidget[]
  }
  enum ReportKind {
    quality_certificate
    session_report
    fault_summary
  }
  enum PageSize {
    a4
    letter
  }
  enum PageOrientation {
    portrait
    landscape
  }
  enum TemplateStatus {
    active
    archived
  }
  enum VariableSource {
    process
    session
    recuperation
    fault_cases
  }
  enum WidgetViewType {
    value
    min_max
    trend
    table
    text
  }
  enum Aggregation {
    avg
    min
    max
    range
    last
    count
  }
  enum WidgetWidth {
    half
    full
  }
}

package "Application" {
  class ReportDataService {
    monitoringApi: ProcessMonitoringApi
    faultsApi: FaultDiagnosisApi
    monitoring: ProcessMonitoringStore
    equipment: EquipmentStore
    traceability: TraceabilityStore
    iam: IamStore
    translate: TranslateService
    contextOfSession(sessionId): Observable<ReportContext>
    resolve(widget, context): ResolvedWidget
  }
  interface ReportContext {
    session: SpraySession
    system: HvofSystem | undefined
    recipe: Recipe | undefined
    recuperation: Recuperation | undefined
    component: RecoveredComponent | undefined
    customer: Customer | undefined
    readings: ProcessReading[]
    byParameter: Map<string, ProcessReading[]>
    faultCases: FaultCase[]
    operatorName: string
  }
  interface TrendData {
    kind: 'trend'
  }
  interface TableData {
    kind: 'table'
  }
  class ReportPdfService {
    data: ReportDataService
    translate: TranslateService
    render(template, context): 
  }
  class ReportingStore {
    api: ReportingApi
    iam: IamStore
    templatesSignal: signal<ReportTemplate[]>
    activeTemplates: computed
    templatesLoadedSignal: signal
    reportsSignal: signal<GeneratedReport[]>
    loadingSignal: signal
    errorSignal: signal<string | null>
    reload(): void
    loadTemplates(): void
    loadGeneratedReports(): void
    getTemplateById(id): Signal<ReportTemplate | undefined>
    templateName(id): string
    templatesOfKind(kind): ReportTemplate[]
    defaultTemplateOf(kind): ReportTemplate | undefined
    reportsOf(subjectId): Signal<GeneratedReport[]>
    changeTemplateStatus(id, status): void
    clearDefault(list, saved): ReportTemplate[]
    formatError(error, fallback): string
  }
}

