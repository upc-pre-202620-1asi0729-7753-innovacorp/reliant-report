    subjectId: number
    format: string
    fileName: string
    periodFrom: string | null
    periodTo: string | null
    generatedAt: string
  }
  class ReportTemplatesApiEndpoint {
    changeStatus(reportTemplateId, status): Observable<ReportTemplate>
  }
  interface ReportTemplatesResponse {
    reportTemplates: ReportTemplateResource[]
  }
  interface ReportTemplateResource {
    id: number
    organizationId: number
