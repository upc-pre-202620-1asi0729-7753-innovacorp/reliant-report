@startuml Reliant_Notifications_v4
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 60
hide empty members

package "SharedKernel" #F5F5F5 {

    package "shared.domain" {

        abstract class AuditableAbstractAggregateRoot {
            + registerEvent(event: Object): void
            + clearDomainEvents(): void
        }
    }

}

package "Notifications" #EDE7F6 {

    package "application" {
        class "ExternalIamService" as ntExtIam <<ACL>> {
            + fetchUserIdsByRole(organizationId: Long, role: String): List<Long>
            + fetchUserEmail(userId: Long): Optional<String>
        }
        interface NotificationDeliveryPort <<Port>> {
            + deliver(alert: Alert, recipientEmail: String): void
        }
        interface NewsletterPort <<Port>> {
            + subscribe(email: String): void
        }
        class AlertCommandServiceImpl <<Application Service>>
        class "NotificationIntegrationEventHandler" as ntHandler <<Policy>> {
            + on(event: ParameterOutOfRangeIntegrationEvent): void
            + on(event: FaultCaseOpenedIntegrationEvent): void
            + on(event: RecurringFaultPatternIntegrationEvent): void
            + on(event: PrematureFailureDetectedIntegrationEvent): void
            + on(event: UnassignedSessionOpenedIntegrationEvent): void
            + on(event: RecipeMismatchIntegrationEvent): void
        }
        ntHandler ..> AlertCommandServiceImpl
        AlertCommandServiceImpl ..> ntExtIam
        AlertCommandServiceImpl ..> NotificationDeliveryPort
        AlertCommandServiceImpl ..> Alert
        AlertCommandServiceImpl ..> NotificationPreference
        ntExtIam ..> IamContextFacade : «ACL»
    }
}


ParameterOutOfRangeIntegrationEvent ..> ntHandler : consumedBy
UnassignedSessionOpenedIntegrationEvent ..> ntHandler : consumedBy
RecipeMismatchIntegrationEvent ..> ntHandler : consumedBy
FaultCaseOpenedIntegrationEvent ..> ntHandler : consumedBy
RecurringFaultPatternIntegrationEvent ..> ntHandler : consumedBy
PrematureFailureDetectedIntegrationEvent ..> ntHandler : consumedBy
AuditableAbstractAggregateRoot <|-- Alert
AuditableAbstractAggregateRoot <|-- NotificationPreference
AuditableAbstractAggregateRoot <|-- NewsletterSubscription

@enduml
