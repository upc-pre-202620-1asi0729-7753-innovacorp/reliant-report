@startuml "Components-ProcessMonitoring-Frontend"
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Reliant - Process Monitoring Component Diagram (Web Application)

Container(api, "Web Services", "Spring Boot", "Exposes /api/v1/spray-sessions")
Container(shared, "Shared", "Angular", "Layout, navigation, auth interceptor, guards, i18n and unit formatting")

Container_Boundary(bc, "Process Monitoring Bounded Context") {
    Component(presentation, "Presentation", "Angular Components", "StartSessionPage, LiveSessionDashboardPage, SessionHistoryPage, ParameterBandCard")
    Component(application, "Application", "Facade, Store, Commands", "ProcessMonitoringFacade, SessionStore (signals, polling), StartSpraySessionCommand, CompleteSpraySessionCommand")
    Component(domain, "Domain", "Client-side entities", "SpraySession, SprayPass, ProcessReading, Band")
    Component(infrastructure, "Infrastructure", "Api services, Assemblers", "SpraySessionsApi, ReadingAssembler")
}

Rel(shared, presentation, "Routes to and wraps")
Rel(presentation, application, "Dispatches commands and reads state from")
Rel(application, domain, "Manages")
Rel(application, infrastructure, "Calls through")
Rel(infrastructure, domain, "Builds")
Rel(infrastructure, api, "Calls /api/v1/spray-sessions on", "HTTPS / JSON, JWT")
@enduml
