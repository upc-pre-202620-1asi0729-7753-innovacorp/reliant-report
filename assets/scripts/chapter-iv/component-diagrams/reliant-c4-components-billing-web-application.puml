@startuml "Components-Billing-Frontend"
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Reliant - Billing Component Diagram (Web Application)

Container(api, "Web Services", "Spring Boot", "Exposes /api/v1/plans, /api/v1/subscriptions")
Container(shared, "Shared", "Angular", "Layout, navigation, auth interceptor, guards, i18n and unit formatting")

Container_Boundary(bc, "Billing Bounded Context") {
    Component(presentation, "Presentation", "Angular Components", "PlansPage, SubscriptionStatusPage")
    Component(application, "Application", "Facade, Store, Commands", "BillingFacade, BillingStore, SubscribeToPlanCommand")
    Component(domain, "Domain", "Client-side entities", "Plan, Subscription")
    Component(infrastructure, "Infrastructure", "Api services, Assemblers", "BillingApi, PlanAssembler, SubscriptionAssembler")
}

Rel(shared, presentation, "Routes to and wraps")
Rel(presentation, application, "Dispatches commands and reads state from")
Rel(application, domain, "Manages")
Rel(application, infrastructure, "Calls through")
Rel(infrastructure, domain, "Builds")
Rel(infrastructure, api, "Calls /api/v1/plans on", "HTTPS / JSON, JWT")
@enduml
