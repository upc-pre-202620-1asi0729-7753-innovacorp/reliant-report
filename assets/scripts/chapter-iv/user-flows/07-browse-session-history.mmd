flowchart TD
    classDef start fill:#2E3138,stroke:#2E3138,color:#FFFFFF
    classDef view fill:#E4F6F1,stroke:#16936F,color:#0B3B2E
    classDef action fill:#FFFFFF,stroke:#5B6170,color:#222222
    classDef decision fill:#FFF3D6,stroke:#E0A100,color:#3A2A00
    classDef error fill:#F9DCD8,stroke:#C0392B,color:#7A1F14
    classDef done fill:#83D8C0,stroke:#0F6E5C,color:#0B3B2E
    S([Supervisor de operación]):::start --> A["/process-monitoring/spray-sessions"]:::view
    A --> B[Filtra por sistema HVOF, orden y rango de fechas]:::action
    B --> C{{¿Hay sesiones que coinciden?}}:::decision
    C -->|no| CE[Tabla vacía]:::error --> D[Limpiar filtros]:::action --> A
    C -->|sí| E[Ordena por inicio y revisa estado y número de desviaciones]:::action
    E --> F[Ver sesión]:::action --> G["/spray-sessions/:id"]:::view
    G --> H{{¿La sesión está activa?}}:::decision
    H -->|sí| I[Lecturas en vivo]:::action
    H -->|no| J[Lecturas registradas, conteo por banda, inicio y fin]:::done
    G --> K[Volver a sesiones]:::action --> A
