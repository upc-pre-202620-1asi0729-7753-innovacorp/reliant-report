flowchart TD
    classDef start fill:#2E3138,stroke:#2E3138,color:#FFFFFF
    classDef view fill:#E4F6F1,stroke:#16936F,color:#0B3B2E
    classDef action fill:#FFFFFF,stroke:#5B6170,color:#222222
    classDef decision fill:#FFF3D6,stroke:#E0A100,color:#3A2A00
    classDef error fill:#F9DCD8,stroke:#C0392B,color:#7A1F14
    classDef done fill:#83D8C0,stroke:#0F6E5C,color:#0B3B2E
    S([Usuario registrado]):::start --> A{{¿Tiene sesión guardada?}}:::decision
    A -->|sí| H["/home"]:::view
    A -->|no| B["/iam/sign-in"]:::view --> C[Ingresa correo y contraseña]:::action
    C --> D{{¿Credenciales válidas?}}:::decision
    D -->|no| E[No se pudo iniciar sesión]:::error --> C
    D -->|sí| H
    H --> F[Barra de navegación según tipo de organización y rol]:::action
    F --> G[Selector EN / ES]:::action --> G2[Toda la interfaz cambia de idioma sin recargar]:::done
    F --> I{{¿Abre una ruta para la que no tiene rol?}}:::decision
    I -->|sí| J[roleGuard redirige al inicio]:::error --> H
    F --> K[Menú de la cuenta: correo y tipo de organización]:::action --> L[Salir]:::action
    L --> M[Se elimina la sesión guardada]:::action --> B
