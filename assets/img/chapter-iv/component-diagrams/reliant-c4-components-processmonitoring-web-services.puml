@startuml "Components-ProcessMonitoring"
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Reliant - Process Monitoring Component Diagram (Web Services)

Container(webapp, "Web Application", "Angular", "Consumes the REST endpoints of this bounded context")
ContainerDb(db, "Database", "PostgreSQL 16", "Persistence of this bounded context")
System_Ext(gateway, "Telemetry Gateway", "Pushes telemetry batches")
Container(downstream, "Reporting", "Spring Boot", "Fetch out-of-range summaries through ProcessMonitoringContextFacade")

Container_Boundary(bc, "Process Monitoring Bounded Context") {
    Component(interfaces, "Interfaces", "REST Controllers, Resources, Assemblers, Context Facade, Integration Events", "SpraySessionController, ProcessMonitoringContextFacade, ParameterOutOfRange / FaultFlagActivated / SpraySessionCompleted integration events")
    Component(application, "Application", "Command and Query Services, Event Handlers, ACL, Ports", "SpraySessionCommandServiceImpl, SpraySessionQueryServiceImpl, ExternalEquipmentService, ExternalTraceabilityService, ExternalIamService (ACL), ExpressionEvaluator port")
    Component(domain, "Domain", "Aggregates, Entities, Value Objects, Commands, Queries, Domain Events, Repository contracts", "SpraySession aggregate; SprayPass, ProcessReading entities; ParameterLimitsSnapshot, TelemetryBatch value objects; repository")
    Component(infrastructure, "Infrastructure", "Spring Data JPA, Adapters", "JpaSpraySessionRepository, SpelExpressionEvaluator")
}

Rel(webapp, interfaces, "Calls", "HTTPS / JSON")
Rel(gateway, interfaces, "Pushes telemetry batches to", "HTTPS / JSON")
Rel(interfaces, application, "Delegates commands and queries to")
Rel(application, domain, "Applies rules through aggregates and repository contracts of")
Rel(infrastructure, domain, "Implements repositories and ports of")
Rel(application, infrastructure, "Uses adapters through ports")
Rel(infrastructure, db, "Reads from and writes to", "JDBC")
Rel(downstream, interfaces, "Consumes through", "ACL")
@enduml
