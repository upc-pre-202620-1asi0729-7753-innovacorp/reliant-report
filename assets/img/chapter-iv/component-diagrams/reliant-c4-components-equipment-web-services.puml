@startuml "Components-Equipment"
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Reliant - Equipment Component Diagram (Web Services)

Container(webapp, "Web Application", "Angular", "Consumes the REST endpoints of this bounded context")
ContainerDb(db, "Database", "PostgreSQL 16", "Persistence of this bounded context")
Container(downstream, "Process Monitoring, Fault Diagnosis, Reporting", "Spring Boot", "Resolve tags, recipe limits, subsystems and parts through EquipmentContextFacade")

Container_Boundary(bc, "Equipment Bounded Context") {
    Component(interfaces, "Interfaces", "REST Controllers, Resources, Assemblers, Context Facade, Integration Events", "HvofSystemController, RecipeController, EquipmentContextFacade")
    Component(application, "Application", "Command and Query Services, Event Handlers, ACL, Ports", "HvofSystemCommandServiceImpl, HvofSystemQueryServiceImpl, RecipeCommandServiceImpl, RecipeQueryServiceImpl, ExternalBillingService (ACL), DataTypeNormalizer port")
    Component(domain, "Domain", "Aggregates, Entities, Value Objects, Commands, Queries, Domain Events, Repository contracts", "HVOFSystem, Recipe, ControllerTagCatalog, TagMappingRule aggregates; HvofSubsystem, HvofPart, Controller, TagNode entities; TagMapping, ParameterLimits, NetworkEndpoint, IpAddressV4 value objects; repositories")
    Component(infrastructure, "Infrastructure", "Spring Data JPA, Adapters", "JPA repositories, Studio5000CsvTagFileParser, JsonTagFileParser, data type normalizers per manufacturer")
}

Rel(webapp, interfaces, "Calls", "HTTPS / JSON")
Rel(interfaces, application, "Delegates commands and queries to")
Rel(application, domain, "Applies rules through aggregates and repository contracts of")
Rel(infrastructure, domain, "Implements repositories and ports of")
Rel(application, infrastructure, "Uses adapters through ports")
Rel(infrastructure, db, "Reads from and writes to", "JDBC")
Rel(downstream, interfaces, "Consumes through", "ACL")
@enduml
