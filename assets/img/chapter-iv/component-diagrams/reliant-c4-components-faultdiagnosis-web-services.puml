@startuml "Components-FaultDiagnosis"
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Reliant - Fault Diagnosis Component Diagram (Web Services)

Container(webapp, "Web Application", "Angular", "Consumes the REST endpoints of this bounded context")
ContainerDb(db, "Database", "PostgreSQL 16", "Persistence of this bounded context")
Container(downstream, "Reporting", "Spring Boot", "Fetch fault counts through FaultDiagnosisContextFacade")

Container_Boundary(bc, "Fault Diagnosis Bounded Context") {
    Component(interfaces, "Interfaces", "REST Controllers, Resources, Assemblers, Context Facade, Integration Events", "FaultCaseController, DiagnosticRuleController, FaultDiagnosisContextFacade, FaultCaseOpened / RecurringFaultPattern integration events")
    Component(application, "Application", "Command and Query Services, Event Handlers, ACL, Ports", "FaultCaseCommandServiceImpl, FaultCaseQueryServiceImpl, FaultDiagnosisIntegrationEventHandler, ExternalEquipmentService (ACL)")
    Component(domain, "Domain", "Aggregates, Entities, Value Objects, Commands, Queries, Domain Events, Repository contracts", "FaultCase, DiagnosticRule, FaultPattern aggregates; FaultSymptom, RuleCondition value objects; repositories")
    Component(infrastructure, "Infrastructure", "Spring Data JPA, Adapters", "JpaFaultCaseRepository, JpaDiagnosticRuleRepository, JpaFaultPatternRepository")
}

Rel(webapp, interfaces, "Calls", "HTTPS / JSON")
Rel(interfaces, application, "Delegates commands and queries to")
Rel(application, domain, "Applies rules through aggregates and repository contracts of")
Rel(infrastructure, domain, "Implements repositories and ports of")
Rel(application, infrastructure, "Uses adapters through ports")
Rel(infrastructure, db, "Reads from and writes to", "JDBC")
Rel(downstream, interfaces, "Consumes through", "ACL")
@enduml
