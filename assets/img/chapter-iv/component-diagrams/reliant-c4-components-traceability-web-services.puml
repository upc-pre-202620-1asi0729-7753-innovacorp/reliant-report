@startuml "Components-Traceability"
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Reliant - Traceability Component Diagram (Web Services)

Container(webapp, "Web Application", "Angular", "Consumes the REST endpoints of this bounded context")
ContainerDb(db, "Database", "PostgreSQL 16", "Persistence of this bounded context")
Container(downstream, "Process Monitoring, Reporting", "Spring Boot", "Check recuperation status and component spec through TraceabilityContextFacade")

Container_Boundary(bc, "Traceability Bounded Context") {
    Component(interfaces, "Interfaces", "REST Controllers, Resources, Assemblers, Context Facade, Integration Events", "RecuperationController, ComponentController, TraceabilityContextFacade, PrematureFailureDetectedIntegrationEvent")
    Component(application, "Application", "Command and Query Services, Event Handlers, ACL, Ports", "RecuperationCommandServiceImpl, RecuperationQueryServiceImpl, ComponentCommandServiceImpl, ComponentQueryServiceImpl, TraceabilityIntegrationEventHandler, ExternalIamService (ACL)")
    Component(domain, "Domain", "Aggregates, Entities, Value Objects, Commands, Queries, Domain Events, Repository contracts", "Customer, Component, Recuperation aggregates; ServiceLifeRecord entity; WorkOrderNumber, ManufacturingOrderNumber, PcrTarget, PowderLot value objects; repositories")
    Component(infrastructure, "Infrastructure", "Spring Data JPA, Adapters", "JpaCustomerRepository, JpaComponentRepository, JpaRecuperationRepository")
}

Rel(webapp, interfaces, "Calls", "HTTPS / JSON")
Rel(interfaces, application, "Delegates commands and queries to")
Rel(application, domain, "Applies rules through aggregates and repository contracts of")
Rel(infrastructure, domain, "Implements repositories and ports of")
Rel(application, infrastructure, "Uses adapters through ports")
Rel(infrastructure, db, "Reads from and writes to", "JDBC")
Rel(downstream, interfaces, "Consumes through", "ACL")
@enduml
