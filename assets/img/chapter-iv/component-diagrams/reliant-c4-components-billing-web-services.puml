@startuml "Components-Billing"
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Reliant - Billing Component Diagram (Web Services)

Container(webapp, "Web Application", "Angular", "Consumes the REST endpoints of this bounded context")
ContainerDb(db, "Database", "PostgreSQL 16", "Persistence of this bounded context")
Container(downstream, "Equipment", "Spring Boot", "Checks monitored system quota through BillingContextFacade")

Container_Boundary(bc, "Billing Bounded Context") {
    Component(interfaces, "Interfaces", "REST Controllers, Resources, Assemblers, Context Facade, Integration Events", "SubscriptionController, BillingContextFacade")
    Component(application, "Application", "Command and Query Services, Event Handlers, ACL, Ports", "SubscriptionCommandServiceImpl, SubscriptionQueryServiceImpl, ExternalIamService (ACL)")
    Component(domain, "Domain", "Aggregates, Entities, Value Objects, Commands, Queries, Domain Events, Repository contracts", "Plan, Subscription aggregates; repositories")
    Component(infrastructure, "Infrastructure", "Spring Data JPA, Adapters", "JpaPlanRepository, JpaSubscriptionRepository")
}

Rel(webapp, interfaces, "Calls", "HTTPS / JSON")
Rel(interfaces, application, "Delegates commands and queries to")
Rel(application, domain, "Applies rules through aggregates and repository contracts of")
Rel(infrastructure, domain, "Implements repositories and ports of")
Rel(application, infrastructure, "Uses adapters through ports")
Rel(infrastructure, db, "Reads from and writes to", "JDBC")
Rel(downstream, interfaces, "Consumes through", "ACL")
@enduml
