@startuml "Components-IAM"
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Reliant - IAM Component Diagram (Web Services)

Container(webapp, "Web Application", "Angular", "Consumes the REST endpoints of this bounded context")
ContainerDb(db, "Database", "PostgreSQL 16", "Persistence of this bounded context")
Container(downstream, "Billing, Traceability, Process Monitoring, Notifications, Reporting", "Spring Boot", "Resolve organizations, users and unit preferences through IamContextFacade")

Container_Boundary(bc, "IAM Bounded Context") {
    Component(interfaces, "Interfaces", "REST Controllers, Resources, Assemblers, Context Facade, Integration Events", "AuthenticationController, UserPreferenceController, IamContextFacade, OrganizationRegisteredIntegrationEvent")
    Component(application, "Application", "Command and Query Services, Event Handlers, ACL, Ports", "UserCommandServiceImpl, UserQueryServiceImpl, UserPreferenceCommandServiceImpl, HashingService and TokenService ports")
    Component(domain, "Domain", "Aggregates, Entities, Value Objects, Commands, Queries, Domain Events, Repository contracts", "Organization, User, UserPreference aggregates; Role entity; Ruc, EmailAddress, UnitOverride value objects; repositories")
    Component(infrastructure, "Infrastructure", "Spring Data JPA, Adapters", "JpaOrganizationRepository, JpaUserRepository, JpaUserPreferenceRepository, BCryptHashingService, JwtTokenService, JwtAuthenticationFilter")
}

Rel(webapp, interfaces, "Calls", "HTTPS / JSON")
Rel(interfaces, application, "Delegates commands and queries to")
Rel(application, domain, "Applies rules through aggregates and repository contracts of")
Rel(infrastructure, domain, "Implements repositories and ports of")
Rel(application, infrastructure, "Uses adapters through ports")
Rel(infrastructure, db, "Reads from and writes to", "JDBC")
Rel(downstream, interfaces, "Consumes through", "ACL")
@enduml
