@startuml "Components-IAM-Frontend"
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Reliant - IAM Component Diagram (Web Application)

Container(api, "Web Services", "Spring Boot", "Exposes /api/v1/authentication, /api/v1/users")
Container(shared, "Shared", "Angular", "Layout, navigation, auth interceptor, guards, i18n and unit formatting")

Container_Boundary(bc, "IAM Bounded Context") {
    Component(presentation, "Presentation", "Angular Components", "SignUpPage, SignInPage, ProfilePage, UnitPreferencesPage, RoleAssignmentPage")
    Component(application, "Application", "Facade, Store, Commands", "IamFacade, IamStore (signals), SignUpCommand, SignInCommand, UpdateUnitPreferenceCommand")
    Component(domain, "Domain", "Client-side entities", "Organization, User, UserPreference")
    Component(infrastructure, "Infrastructure", "Api services, Assemblers", "AuthenticationApi, UsersApi, UserAssembler")
}

Rel(shared, presentation, "Routes to and wraps")
Rel(presentation, application, "Dispatches commands and reads state from")
Rel(application, domain, "Manages")
Rel(application, infrastructure, "Calls through")
Rel(infrastructure, domain, "Builds")
Rel(infrastructure, api, "Calls /api/v1/authentication on", "HTTPS / JSON, JWT")
@enduml
